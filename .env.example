# ─────────────────────────────────────────────────────────────────────────────
# Beauty Empire — environment variables
# Copy to `.env` for local development. NEVER commit real secrets.
# On Vercel, set these in Project → Settings → Environment Variables.
# Only variables prefixed NEXT_PUBLIC_ are ever exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
# PostgreSQL connection string. Local default matches docker-compose.yml.
DATABASE_URL="postgresql://beauty:beauty_dev_pw@localhost:5433/beauty_empire?schema=public"

# Better Auth secret: 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Public base URL of the site (no trailing slash). Use https:// in production —
# secure cookies, HSTS and upgrade-insecure-requests switch on automatically.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Salon timezone (IANA). All slots are computed in this zone; timestamps are stored in UTC.
SALON_TIMEZONE="Asia/Kolkata"

# ── Seeding (development / first deploy) ─────────────────────────────────────
# The seed creates accounts ONLY when passwords are provided here. Use long random values.
SEED_ADMIN_EMAIL="admin@beautyempire.test"
SEED_ADMIN_PASSWORD=""
# Optional: enable logins for the 5 sample staff (dev only — ignored in production).
SEED_STAFF_PASSWORD=""
# Optional: enable logins for the 5 sample customers (dev only).
SEED_CUSTOMER_PASSWORD=""
# Set to "false" to skip demo customers/bookings/reviews.
SEED_DEMO_DATA="true"

# ── Email — Resend (optional in development) ─────────────────────────────────
# Without RESEND_API_KEY, emails are NOT sent: in development they are written to ./.dev-mail
# so you can open verification / reset links locally.
RESEND_API_KEY=""
EMAIL_FROM="Beauty Empire <bookings@yourdomain.com>"

# ── Payments — Razorpay (optional) ───────────────────────────────────────────
# Without keys, "Pay online" is shown as unavailable and only Pay-at-Salon is offered.
# Use rzp_test_… keys for testing. Webhook URL: https://<your-domain>/api/payments/razorpay/webhook
# (events: payment.captured, payment.failed, order.paid)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Image uploads — Cloudinary (required for uploads in production) ──────────
# Without Cloudinary, development uploads are stored in ./public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="beauty-empire"

# ── Rate limiting — Upstash Redis (recommended in production) ────────────────
# Without Upstash, an in-memory limiter is used (per server instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/reminders.
CRON_SECRET=""

# ── Testing ──────────────────────────────────────────────────────────────────
# Used by the Playwright config only — leave unset in real deployments:
#   AUTH_SIGNIN_MAX_PER_MINUTE  sign-in attempts per IP per minute (default 5)
#   DEV_MAIL_OUTBOX=true        write emails to ./.dev-mail even in a production build
# Separate database for integration & E2E tests (its name must contain "test").
TEST_DATABASE_URL="postgresql://beauty:beauty_dev_pw@localhost:5433/beauty_empire_test?schema=public"
